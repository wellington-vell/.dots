+-- Screen Picker -------------------------------------------------------------------
+
+-- slurp in output mode: the screen under the pointer is shown clear with a border in
+-- the theme's primary color (read from Noctalia's generated Hyprland theme), the
+-- others are dimmed, and a click prints that output's connector name.
+local OUTPUT_PICK_CMD = [[
+c=$(sed -n 's/^local primary = "rgb(\([0-9a-fA-F]\{6\}\))".*/\1/p' "$HOME/.config/hypr/noctalia.lua" 2>/dev/null)
+exec slurp -o -r -f '%o' -b '#000000a6' -B '#00000000' -s '#00000000' -c "#${c:-7aa2f7}ff" -w 4
+]]
+
+local function isKnownOutput(name)
+    for _, out in noctalia.outputs() do
+        if out.name == name then return true end
+    end
+    return false
+end
+
+local function pickOutputAsync(errorTitle, callback)
+    local outputs = noctalia.outputs()
+    if #outputs == 1 then
+        callback(outputs[1].name)
+        return
+    end
+    if not noctalia.commandExists("slurp") then
+        log("screen pick: slurp not found")
+        noctalia.notifyError(errorTitle, noctalia.tr("notify.output-picker-missing"))
+        callback(nil)
+        return
+    end
+
+    log("screen pick: waiting for a click")
+    local ok = noctalia.runAsync(OUTPUT_PICK_CMD, function(result)
+        local name = noctalia.string.trim(result.stdout or "")
+        if result.exitCode ~= 0 or not isKnownOutput(name) then
+            log("screen pick: cancelled or unknown output")
+            callback(nil)
+            return
+        end
+        log(`screen pick: picked {name}`)
+        callback(name)
+    end)
+    if not ok then callback(nil) end
+end
+
+-- Pick a screen then run `proceed` with pickedOutput set, guards reentry
+local function pickOutputThen(errorTitle, proceed)
+    pickInProcess = true
+    pickOutputAsync(errorTitle, function(name)
+        pickInProcess = false
+        if state ~= "idle" or name == nil then return end
+        pickedOutput = name
+        proceed()
+    end)
+end
